+def run_xdf_optional(image: Path, *commands: str) -> None:
+    """Run an xdftool command whose target may legitimately be absent.
+
+    The WBStartup/Welcome first-run program is an AmigaOS 3.2 addition.  An
+    expanded 3.1 tree has WBStartup but no Welcome, so deleting it must not
+    fail the build.
+    """
+    subprocess.run([*xdf_tool(), str(image), *commands], check=False,
+                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
