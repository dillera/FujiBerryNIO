diff --git a/src/platform/mac68k/fn_transport.c b/src/platform/mac68k/fn_transport.c
new file mode 100644
index 0000000..4f5d322
--- /dev/null
+++ b/src/platform/mac68k/fn_transport.c
@@ -0,0 +1,188 @@
+/*
+ * fn_transport.c - classic Macintosh (68k) transport over the floppy port
+ *
+ * The FujiNet Mac board presents its disks to the Mac as Directly Connected
+ * Disks (HD20s) on the floppy port. fujinet-nio makes every such unit
+ * FN_MAC_MAILBOX_BLOCKS blocks longer than its image; those blocks are a
+ * mailbox: writing them sends one raw FujiBus packet, reading them returns
+ * the response. So the whole transport is ordinary driver-level block I/O
+ * through the ROM's HD20 support in the .Sony driver: no INIT, no driver,
+ * no hardware access.
+ *
+ *   mailbox block 0: "FNIO" version state seq(u16) length(u32) reserved(4)
+ *                    then the packet; state 1 = response ready.
+ *
+ * Compiler: Retro68 (m68k-apple-macos-gcc). Runs on a 512Ke/Plus/SE and up
+ * (any Mac whose ROM drives HD20s); System 6.0.8 tested.
+ */
+
+#include <Files.h>
+#include <Devices.h>
+#include <Events.h>
+
+#include <string.h>
+
+#include "fujinet-nio.h"
+#include "fn_platform.h"
+#include "fn_internal.h"
+
+#define FN_MAC_MAILBOX_BLOCKS 16
+#define FN_MAC_BLOCK 512
+#define FN_MAC_HEADER 16
+#define FN_MAC_MAILBOX_BYTES (FN_MAC_MAILBOX_BLOCKS * FN_MAC_BLOCK)
+#define FN_MAC_TIMEOUT_TICKS (60 * 10)
+
+enum { MB_IDLE = 0, MB_READY = 1, MB_PENDING = 2 };
+
+static struct {
+    short drive;      /* drive number in the drive queue */
+    short refnum;     /* its driver (.Sony) */
+    long base;        /* first mailbox block */
+    uint16_t seq;
+    uint8_t ready;
+} g_mac;
+
+/* Word aligned: the driver moves words into it, and an odd address is an
+ * address error on a 68000. */
+static uint8_t g_blocks[FN_MAC_MAILBOX_BYTES] __attribute__((aligned(4)));
+
+static OSErr block_io(short trap_write, long block, uint8_t *buf, long count)
+{
+    ParamBlockRec pb;
+
+    memset(&pb, 0, sizeof(pb));
+    pb.ioParam.ioRefNum = g_mac.refnum;
+    pb.ioParam.ioVRefNum = g_mac.drive;
+    pb.ioParam.ioBuffer = (Ptr)buf;
+    pb.ioParam.ioReqCount = count * FN_MAC_BLOCK;
+    pb.ioParam.ioPosMode = fsFromStart;
+    pb.ioParam.ioPosOffset = block * FN_MAC_BLOCK;
+    return trap_write ? PBWriteSync(&pb) : PBReadSync(&pb);
+}
+
+/* DrvQHdr is a low-memory global at $308; GetDrvQHdr() is glue that Retro68
+ * does not ship. GCC flags any fixed-address access as out of bounds. */
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Warray-bounds"
+static DrvQEl *first_drive(void)
+{
+    return (DrvQEl *)((QHdrPtr)0x0308)->qHead;
+}
+#pragma GCC diagnostic pop
+
+static long drive_blocks(const DrvQEl *q)
+{
+    /* qType 1: the size is 32 bits, dQDrvSz2 the high word. */
+    if (q->qType == 1)
+        return ((long)q->dQDrvSz2 << 16) | q->dQDrvSz;
+    return q->dQDrvSz;
+}
+
+uint8_t fn_transport_init(void)
+{
+    DrvQEl *q;
+
+    if (g_mac.ready)
+        return FN_OK;
+
+    for (q = first_drive(); q != NULL; q = (DrvQEl *)q->qLink) {
+        long blocks = drive_blocks(q);
+
+        if (blocks <= FN_MAC_MAILBOX_BLOCKS)
+            continue;
+        g_mac.drive = q->dQDrive;
+        g_mac.refnum = q->dQRefNum;
+        g_mac.base = blocks - FN_MAC_MAILBOX_BLOCKS;
+        if (block_io(0, g_mac.base, g_blocks, 1) == noErr &&
+            memcmp(g_blocks, "FNIO", 4) == 0) {
+            g_mac.seq = (uint16_t)((g_blocks[6] << 8) | g_blocks[7]);
+            g_mac.ready = 1;
+            return FN_OK;
+        }
+    }
+    return FN_ERR_NOT_FOUND;
+}
+
+void fn_transport_close(void)
+{
+    g_mac.ready = 0;
+}
+
+uint8_t fn_transport_ready(void)
+{
+    return g_mac.ready;
+}
+
+uint8_t fn_transport_exchange(void)
+{
+    return fn_transport_exchange_buffers(_fn_transport_ctx.request,
+                                         _fn_transport_ctx.req_len,
+                                         _fn_transport_ctx.response,
+                                         _fn_transport_ctx.resp_max,
+                                         &_fn_transport_ctx.resp_len);
+}
+
+uint8_t fn_transport_exchange_buffers(const uint8_t *request,
+                                      uint16_t request_length,
+                                      uint8_t *response,
+                                      uint16_t response_capacity,
+                                      uint16_t *response_length)
+{
+    long nblocks, got, deadline;
+    uint32_t length;
+    uint16_t seq;
+
+    if (response_length == NULL || request == NULL || response == NULL)
+        return FN_ERR_INVALID;
+    *response_length = 0;
+    if (!g_mac.ready)
+        return FN_ERR_NOT_FOUND;
+    if ((long)request_length + FN_MAC_HEADER > FN_MAC_MAILBOX_BYTES)
+        return FN_ERR_INVALID;
+
+    seq = ++g_mac.seq;
+    memset(g_blocks, 0, FN_MAC_HEADER);
+    memcpy(g_blocks, "FNIO", 4);
+    g_blocks[4] = 1;
+    g_blocks[6] = (uint8_t)(seq >> 8);
+    g_blocks[7] = (uint8_t)seq;
+    g_blocks[10] = (uint8_t)(request_length >> 8);
+    g_blocks[11] = (uint8_t)request_length;
+    memcpy(g_blocks + FN_MAC_HEADER, request, request_length);
+    nblocks = ((long)request_length + FN_MAC_HEADER + FN_MAC_BLOCK - 1) / FN_MAC_BLOCK;
+    if (block_io(1, g_mac.base, g_blocks, nblocks) != noErr)
+        return FN_ERR_IO;
+
+    /* The FujiNet usually answers before the write completes on the Mac
+     * side; poll the header block until the response for this seq is up. */
+    deadline = TickCount() + FN_MAC_TIMEOUT_TICKS;
+    for (;;) {
+        if (block_io(0, g_mac.base, g_blocks, 1) != noErr)
+            return FN_ERR_IO;
+        if (memcmp(g_blocks, "FNIO", 4) != 0)
+            return FN_ERR_IO;
+        if (g_blocks[5] == MB_READY &&
+            ((uint16_t)((g_blocks[6] << 8) | g_blocks[7])) == seq)
+            break;
+        if (TickCount() > deadline)
+            return FN_ERR_TIMEOUT;
+    }
+
+    length = ((uint32_t)g_blocks[8] << 24) | ((uint32_t)g_blocks[9] << 16) |
+             ((uint32_t)g_blocks[10] << 8) | g_blocks[11];
+    if (length > response_capacity || length + FN_MAC_HEADER > FN_MAC_MAILBOX_BYTES)
+        return FN_ERR_INVALID;
+    nblocks = ((long)length + FN_MAC_HEADER + FN_MAC_BLOCK - 1) / FN_MAC_BLOCK;
+    if (nblocks > 1 &&
+        block_io(0, g_mac.base + 1, g_blocks + FN_MAC_BLOCK, nblocks - 1) != noErr)
+        return FN_ERR_IO;
+    got = (long)length;
+    memcpy(response, g_blocks + FN_MAC_HEADER, (size_t)got);
+    *response_length = (uint16_t)got;
+    return FN_OK;
+}
+
+const char *fn_platform_name(void)
+{
+    return "mac68k";
+}
