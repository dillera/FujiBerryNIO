+    /// Builds an image from ready-made bitstream tracks, MSB first: for
+    /// example GCR tracks encoded by a FujiNet. `tracks(side, track)` returns
+    /// a track's bytes and its length in bits, or `None` to leave it blank.
+    pub fn from_bitstreams(
+        floppy_type: FloppyType,
+        title: &str,
+        mut tracks: impl FnMut(usize, usize) -> Option<(Vec<u8>, usize)>,
+    ) -> Self {
+        let mut img = Self::new(floppy_type, title);
+        for side in 0..FLOPPY_MAX_SIDES {
+            for track in 0..FLOPPY_MAX_TRACKS {
+                if let Some((mut data, bits)) = tracks(side, track) {
+                    data.resize(bits / 8 + 1, 0xFF);
+                    img.bitlen[side][track] = bits;
+                    img.trackdata[side][track] = data;
+                    img.origtracktype[side][track] = OriginalTrackType::Bitstream;
+                }
+            }
+        }
+        img
+    }
+
+    /// A bitstream track's bytes (MSB first) and its length in bits, or
+    /// `None` for a flux track.
+    pub fn track_bitstream(&self, side: usize, track: usize) -> Option<(&[u8], usize)> {
+        match self.get_track_type(side, track) {
+            TrackType::Bitstream => Some((&self.trackdata[side][track], self.bitlen[side][track])),
+            TrackType::Flux => None,
+        }
+    }
+
