index 09c6c6c..c3269dd 100644
--- a/amiga/disk.device/fujinet_disk_device.c
+++ b/amiga/disk.device/fujinet_disk_device.c
@@ -8,6 +8,9 @@
 #include <exec/memory.h>
 #include <devices/newstyle.h>
 #include <devices/trackdisk.h>
+/* BPTR (the device's seglist) lives in <dos/dos.h>.  Some NDK header sets
+   pull it in transitively; NDK 3.2 as shipped with amiga-gcc does not. */
+#include <dos/dos.h>
 #include <proto/exec.h>
 
 #include <string.h>
diff --git a/amiga/tests/stubs/dos/dos.h b/amiga/tests/stubs/dos/dos.h
new file mode 100644
index 0000000..d206d12
--- /dev/null
+++ b/amiga/tests/stubs/dos/dos.h
@@ -0,0 +1,15 @@
+#ifndef FUJINET_DISK_STUB_DOS_DOS_H
+#define FUJINET_DISK_STUB_DOS_DOS_H
+
+/* Stub for the native (host) resident tests.
+ *
+ * On a real m68k build BPTR comes from the NDK's <dos/dos.h>, which
+ * disk.device/fujinet_disk_device.c includes for its seglist parameter.
+ * The stub tree already defines BPTR in <exec/types.h>, so this header only
+ * has to exist -- redefining the typedef here would break the -std=c99
+ * -pedantic -Werror build with a typedef redefinition.
+ */
+
+#include <exec/types.h>
+
+#endif /* FUJINET_DISK_STUB_DOS_DOS_H */
