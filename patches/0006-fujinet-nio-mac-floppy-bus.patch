diff --git a/include/fujinet/io/transport/mac_floppy_framer.h b/include/fujinet/io/transport/mac_floppy_framer.h
new file mode 100644
index 0000000..d63cdac
--- /dev/null
+++ b/include/fujinet/io/transport/mac_floppy_framer.h
@@ -0,0 +1,150 @@
+#pragma once
+
+#include "fujinet/io/transport/iframer.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <vector>
+
+namespace fujinet::disk {
+class DiskService;
+}
+
+namespace fujinet::io {
+
+// Macintosh floppy-port bus (FujiNet Mac 68k board).
+//
+// On the board a Raspberry Pi Pico sits on the Mac's DB-19 floppy port and
+// emulates the drive side of the Directly Connected Disk (DCD, HD20)
+// protocol; the FujiNet MCU serves the disk blocks over a one-character
+// command protocol (fujinet-firmware lib/bus/mac/mac.h). This framer is the
+// FujiNet side of that protocol, so the same Pico firmware (or an emulator
+// that plays the Pico's role, such as Snow) can talk to fujinet-nio:
+//
+//   drive side -> FujiNet
+//     'A'..'D'        select DCD unit 0..3
+//     'R' b2 b1 b0    read block (24-bit BE)       -> 512 bytes
+//     'W' b2 b1 b0 d  write block (512 data bytes) -> 'w' ok / 'e' error
+//     'T'             status of the selected unit  -> 336 bytes
+//     '?'             how many DCD units?          -> 'h' n   (fujinet-nio)
+//
+//   FujiNet -> drive side (unsolicited)
+//     'h' n           n units are mounted in a contiguous chain from unit 0
+//
+// The 800K GCR floppy (DiskService slot FLOPPY_SLOT, a 400K or 800K sector
+// image), with the board's floppy commands:
+//
+//   drive side -> FujiNet
+//     '0' / '4'       step direction: inward / outward
+//     '1'             step                        -> track | 0x80, or 'N'
+//     '2' / '6'       motor on / off              -> 'M' / 'F'
+//     '7'             eject (the slot is unmounted) -> 'E'
+//   FujiNet -> drive side (unsolicited)
+//     's' t / 'd' t   single / double sided disk inserted, head at t | 0x80
+//     'u' / 'l'       writable / write protected
+//     'r'             disk removed
+//
+// On the board the ESP32 streams the encoded tracks from its RMT peripheral
+// and receives the Mac's writes as captured WR bitstreams. A drive side with
+// no such wires (an emulator) uses two more commands instead:
+//
+//     '#' cyl side               -> nbits(u32 BE), GCR track bits (MSB first)
+//     'P' cyl side nbits(u32 BE) <bits>
+//                                 a whole track as the Mac left it; the sectors
+//                                 are decoded and written   -> 'p' n (written)
+//     '!'                        polled mode: from now on nothing is sent
+//                                 unasked, and '?' answers 'h' n f, where f is
+//                                 the floppy: 0 none, 1 400K, 2 800K, | 0x80 if
+//                                 write protected
+//
+// Unsolicited bytes can land in front of a reply the drive side is already
+// waiting for; the board's Pico drains its UART before each command and
+// polls between them. An emulator talks to NIO over a socket with no such
+// rhythm, so it asks for polled mode instead.
+//
+// FujiBus over the floppy port. Every DCD unit reports MAILBOX_BLOCKS more
+// blocks than its image holds. Those blocks never reach the image: a write
+// starting at the first of them carries one raw FujiBus packet from the Mac,
+// and reading them returns the response. The Mac needs nothing but ordinary
+// block I/O through its ROM HD20 driver, and the drive side needs no changes.
+//
+//   mailbox block 0, bytes 0..15:
+//     "FNIO"  version(1)  state  seq(u16 BE)  length(u32 BE)  reserved(4)
+//   packet bytes follow at offset 16 and continue through later blocks.
+//   state (response side): 0 idle, 1 response ready, 2 request pending.
+class MacFloppyFramer : public IFramer {
+public:
+    static constexpr std::size_t   DCD_UNITS          = 4;
+    static constexpr std::uint32_t MAILBOX_BLOCKS     = 16;
+    static constexpr std::size_t   BLOCK_BYTES        = 512;
+    static constexpr std::size_t   MAILBOX_HEADER     = 16;
+    static constexpr std::size_t   MAILBOX_MAX_PACKET = MAILBOX_BLOCKS * BLOCK_BYTES - MAILBOX_HEADER;
+    static constexpr std::size_t   STATUS_BYTES       = 336;
+    static constexpr std::size_t   FLOPPY_SLOT        = 4;
+
+    // onEject: the Mac ejected the medium in a slot. Defaults to a plain
+    // unmount; the disk device also forgets it so it is not restored.
+    // serveFloppy: offer the floppy slot at all. Only a drive side that can
+    // take tracks through '#'/'P' (an emulator) can use it until the ESP32
+    // side streams tracks to the board's floppy wires.
+    explicit MacFloppyFramer(disk::DiskService& disks,
+                             std::function<void(std::size_t)> onEject = {},
+                             bool serveFloppy = true);
+
+    void poll(Channel& ch) override;
+    bool nextPacket(ByteBuffer& outPacket) override;
+    void sendPacket(Channel& ch, const ByteBuffer& packet) override;
+
+private:
+    enum MailboxState : std::uint8_t { Idle = 0, Ready = 1, Pending = 2 };
+
+    // Returns false when more bytes are needed to finish the command at the
+    // front of _rx.
+    bool handle_command(Channel& ch);
+
+    std::uint32_t image_blocks(std::size_t unit);
+    std::size_t count_units();
+    void announce_units(Channel& ch, bool force);
+
+    void read_block(std::size_t unit, std::uint32_t block, std::uint8_t* out);
+    bool write_block(std::size_t unit, std::uint32_t block, const std::uint8_t* in);
+    void build_status(std::size_t unit, std::uint8_t* out);
+
+    void mailbox_read(std::uint32_t index, std::uint8_t* out);
+    void mailbox_write(std::uint32_t index, const std::uint8_t* in);
+
+    // Floppy
+    int floppy_sides();                       // 1 or 2 when a Mac floppy is in, else 0
+    void announce_floppy(Channel& ch);
+    bool floppy_command(Channel& ch, std::uint8_t c);
+    std::vector<std::uint8_t> encode_track(int cyl, int side);
+    int write_track(int cyl, int side, const std::uint8_t* bits, std::uint32_t nbits);
+
+    disk::DiskService& _disks;
+    std::function<void(std::size_t)> _onEject;
+    std::deque<std::uint8_t> _rx;
+    std::size_t _unit{0};
+    int _announced{-1};
+    bool _pendingActivated{false};
+
+    // Mailbox: the request being assembled and the latest response.
+    std::vector<std::uint8_t> _request;
+    std::size_t _requestHave{0};
+    std::uint16_t _requestSeq{0};
+    std::deque<ByteBuffer> _packets;
+    std::vector<std::uint8_t> _response;
+    std::uint16_t _responseSeq{0};
+    MailboxState _state{Idle};
+
+    // Floppy: what the drive side has been told, and the head position.
+    int _floppyAnnounced{0};                  // sides announced, 0 = none
+    bool _polled{false};                      // '!': answer '?' only
+    bool _serveFloppy{true};
+    int _head{0};
+    int _stepDir{1};
+};
+
+} // namespace fujinet::io
