+    // One read of a batch: `bytes` (at most 512) at `offset` of `fileHandle`.
+    struct ReadAt {
+        int fileHandle{-1};
+        uint32_t offset{0};
+        uint8_t* dst{nullptr};
+        std::size_t bytes{0};
+        std::size_t got{0}; // filled in; 0 when this read failed
+    };
+
+    // Whether read_parallel() can keep several requests in flight. A TNFS
+    // server handles each UDP datagram on its own, so reads on different
+    // handles can overlap; over TCP a server may drop requests that arrive
+    // in one segment.
+    virtual bool supports_parallel_reads() const { return false; }
+
+    // Seek every handle, then read every handle, with all requests of each
+    // phase in flight together: about two round trips for the whole batch.
+    // Every entry needs its own handle. Afterwards the handles' positions
+    // are unknown to the caller.
+    virtual void read_parallel(std::vector<ReadAt>& reads)
+    {
+        for (auto& r : reads) {
