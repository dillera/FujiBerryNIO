+    /// Fetches every track of the FujiNet's floppy, GCR encoded by it:
+    /// `[cylinder][side]`.
+    pub fn floppy_tracks(&mut self, sides: usize) -> Option<Vec<[Option<(Vec<u8>, usize)>; 2]>> {
+        let link = self.link.as_mut()?;
+        let mut tracks = Vec::with_capacity(80);
+        for cyl in 0..80 {
+            let mut t: [Option<(Vec<u8>, usize)>; 2] = [None, None];
+            for (side, slot) in t.iter_mut().enumerate().take(sides) {
+                match link.track(cyl, side) {
+                    Ok((data, bits)) if bits > 0 => *slot = Some((data, bits)),
+                    Ok(_) => (),
+                    Err(e) => {
+                        self.drop_link(e);
+                        return None;
+                    }
+                }
+            }
+            tracks.push(t);
+        }
+        Some(tracks)
+    }
+
+    /// Sends a written track back to the FujiNet; returns sectors written.
+    pub fn floppy_put_track(&mut self, cyl: usize, side: usize, data: &[u8], bits: usize) -> Option<u8> {
+        let link = self.link.as_mut()?;
+        match link.put_track(cyl, side, data, bits) {
+            Ok(n) => Some(n),
+            Err(e) => {
+                self.drop_link(e);
+                None
+            }
+        }
+    }
+
+    /// Tells the FujiNet the Mac ejected its floppy.
+    pub fn floppy_eject(&mut self) {
+        if let Some(link) = self.link.as_mut()
+            && let Err(e) = link.floppy_command(b'7')
+        {
+            self.drop_link(e);
+        }
+    }
