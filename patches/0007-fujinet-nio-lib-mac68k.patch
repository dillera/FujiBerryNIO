diff --git a/makefiles/compiler-macgcc.mk b/makefiles/compiler-macgcc.mk
new file mode 100644
index 0000000..1add80d
--- /dev/null
+++ b/makefiles/compiler-macgcc.mk
@@ -0,0 +1,16 @@
+# compiler-macgcc.mk - Retro68 cross-compiler for the classic 68k Mac
+#
+# Requires a built Retro68 toolchain:
+#   https://github.com/autc04/Retro68
+# Add to PATH: export PATH=$RETRO68_BUILD/toolchain/bin:$PATH
+
+CC      = m68k-apple-macos-gcc
+AR      = m68k-apple-macos-ar
+AS      = m68k-apple-macos-as
+
+# -mcpu=68000: every Mac with HD20 support in ROM (512Ke, Plus, SE) and up
+CFLAGS  = -Wall -O2 -std=gnu99 -mcpu=68000 -ffunction-sections -fdata-sections
+
+ASFLAGS =
+ARFLAGS = rcs
+LIBEXT  = .a
diff --git a/makefiles/compiler.mk b/makefiles/compiler.mk
index 7f6887c..e4ba603 100644
--- a/makefiles/compiler.mk
+++ b/makefiles/compiler.mk
@@ -17,6 +17,8 @@ else ifeq ($(COMPILER_FAMILY),gcc)
     -include makefiles/compiler-gcc.mk
 else ifeq ($(COMPILER_FAMILY),amigagcc)
     -include makefiles/compiler-amigagcc.mk
+else ifeq ($(COMPILER_FAMILY),macgcc)
+    -include makefiles/compiler-macgcc.mk
 else
     $(error Unknown compiler family: $(COMPILER_FAMILY))
 endif
