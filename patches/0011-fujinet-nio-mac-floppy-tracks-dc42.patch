+namespace fujinet::disk {
+
+// Apple DiskCopy 4.2 image: an 84-byte header, then 512-byte sectors, then
+// optional 12-byte tags (not used). Written sectors leave the header's
+// checksums stale, as other FujiNet firmware does.
+std::unique_ptr<IDiskImage> make_dc42_disk_image();
+
+// DiskCopy 4.2 header fields, for the image probe.
+struct Dc42Header {
+    std::uint32_t dataBytes{0};
+    std::uint32_t tagBytes{0};
+};
+
+// Parse the first 84 bytes of a file. False unless it is a DiskCopy 4.2
+// image whose data fits in `fileBytes`.
+bool parse_dc42_header(const std::uint8_t* header84, std::uint64_t fileBytes, Dc42Header& out) noexcept;
+
+} // namespace fujinet::disk
