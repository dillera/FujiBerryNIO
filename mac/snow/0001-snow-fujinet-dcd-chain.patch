diff --git a/testrunner/src/bin/fnrun/main.rs b/testrunner/src/bin/fnrun/main.rs
new file mode 100644
index 0000000..cd63d38
--- /dev/null
+++ b/testrunner/src/bin/fnrun/main.rs
@@ -0,0 +1,202 @@
+//! Scripted headless runner: boots a Mac, drives the mouse and keyboard
+//! from a script and saves screenshots. Used to test the FujiNet DCD chain
+//! (SNOW_FUJINET_DCD) without a display.
+//!
+//! Script, one command per line (# comments):
+//!   rom <file>            model is detected from the ROM
+//!   floppy <drive> <file>
+//!   run <seconds>         run this much emulated time
+//!   shot <file.png>
+//!   move <x> <y>          absolute pointer position
+//!   down | up | click | dclick
+//!   key <hex> [cmd]       AEK scancode, optionally with Command held
+//!   type <text>           letters, digits, space, '.', ':' and '/'
+//!   until <seconds> <file.png>  like run, but stop early when the screen
+//!                         stops changing for a second (then shoot)
+
+use std::fs::{self, File};
+
+use anyhow::{Context, Result, bail};
+use snow_core::emulator::Emulator;
+use snow_core::emulator::comm::{EmulatorCommand, EmulatorSpeed};
+use snow_core::keymap::{KeyEvent, Keymap};
+use snow_core::mac::MacModel;
+use snow_core::tickable::Tickable;
+
+const PLUS_HZ: f64 = 7_833_600.0;
+
+struct Runner {
+    emu: Emulator,
+    frames: std::sync::Arc<std::sync::Mutex<Option<snow_core::renderer::DisplayBuffer>>>,
+    cmd: snow_core::emulator::comm::EmulatorCommandSender,
+    events: snow_core::emulator::comm::EmulatorEventReceiver,
+    last: Option<(u16, u16, Vec<u8>)>,
+}
+
+impl Runner {
+    fn pump(&mut self) -> bool {
+        // The event channel is bounded: an undrained one stalls the emulator.
+        while self.events.try_recv().is_ok() {}
+        let mut changed = false;
+        if let Some(buf) = self.frames.lock().unwrap().take() {
+            let (w, h) = (buf.width(), buf.height());
+            let data = buf.into_inner();
+            changed = self.last.as_ref().is_none_or(|l| l.2 != data);
+            self.last = Some((w, h, data));
+        }
+        changed
+    }
+
+    fn run(&mut self, secs: f64) -> Result<()> {
+        let target = self.emu.get_cycles() + (secs * PLUS_HZ) as u64;
+        while self.emu.get_cycles() < target {
+            self.emu.tick(1, ())?;
+            self.pump();
+        }
+        Ok(())
+    }
+
+    fn until_idle(&mut self, secs: f64) -> Result<()> {
+        let start = self.emu.get_cycles();
+        let target = start + (secs * PLUS_HZ) as u64;
+        let mut last_change = start;
+        while self.emu.get_cycles() < target {
+            self.emu.tick(1, ())?;
+            if self.pump() {
+                last_change = self.emu.get_cycles();
+            }
+            if self.emu.get_cycles() - last_change > PLUS_HZ as u64 * 2 {
+                break;
+            }
+        }
+        Ok(())
+    }
+
+    fn shot(&mut self, path: &str) -> Result<()> {
+        self.pump();
+        let Some((w, h, data)) = self.last.as_ref() else {
+            bail!("no frame yet");
+        };
+        let mut enc = png::Encoder::new(File::create(path)?, *w as u32, *h as u32);
+        enc.set_color(png::ColorType::Rgba);
+        enc.set_depth(png::BitDepth::Eight);
+        enc.write_header()?.write_image_data(data)?;
+        println!("shot {}", path);
+        Ok(())
+    }
+
+    fn send(&mut self, c: EmulatorCommand) -> Result<()> {
+        self.cmd.send(c)?;
+        // Let the emulator loop pick the command up.
+        self.run(0.02)
+    }
+
+    fn button(&mut self, down: bool) -> Result<()> {
+        self.send(EmulatorCommand::MouseUpdateRelative { relx: 0, rely: 0, btn: Some(down) })
+    }
+
+    fn key(&mut self, sc: u8, cmd: bool) -> Result<()> {
+        if cmd {
+            self.send(EmulatorCommand::KeyEvent(KeyEvent::KeyDown(0x37, Keymap::AekM0115)))?;
+        }
+        self.send(EmulatorCommand::KeyEvent(KeyEvent::KeyDown(sc, Keymap::AekM0115)))?;
+        self.send(EmulatorCommand::KeyEvent(KeyEvent::KeyUp(sc, Keymap::AekM0115)))?;
+        if cmd {
+            self.send(EmulatorCommand::KeyEvent(KeyEvent::KeyUp(0x37, Keymap::AekM0115)))?;
+        }
+        Ok(())
+    }
+}
+
+fn scancode(c: char) -> Option<(u8, bool)> {
+    let letters = "asdfhgzxcv_bqweryt123465=97-80]ou[ip_lj'k;\\,/nm.";
+    if let Some(i) = letters.find(c.to_ascii_lowercase()) {
+        if c != '_' {
+            return Some((i as u8, c.is_ascii_uppercase()));
+        }
+    }
+    Some(match c {
+        ' ' => (0x31, false),
+        ':' => (0x29, true),
+        '\n' => (0x24, false),
+        _ => return None,
+    })
+}
+
+fn main() -> Result<()> {
+    env_logger::Builder::from_default_env()
+        .filter_level(log::LevelFilter::Info)
+        .init();
+    let script_path = std::env::args().nth(1).context("usage: fnrun <script>")?;
+    let script = fs::read_to_string(&script_path)?;
+    let mut lines = script.lines().map(str::trim).filter(|l| !l.is_empty() && !l.starts_with('#'));
+
+    let first = lines.next().context("empty script")?;
+    let rom_path = first.strip_prefix("rom ").context("script must start with 'rom <file>'")?;
+    let rom = fs::read(rom_path)?;
+    let model = MacModel::detect_from_rom(&rom).context("unknown ROM")?;
+    let (emu, frames) = Emulator::new(&rom, &[], model)?;
+    let cmd = emu.create_cmd_sender();
+    let events = emu.create_event_recv();
+    let mut r = Runner { emu, frames, cmd, events, last: None };
+
+    let mut started = false;
+    for line in lines {
+        let (op, arg) = line.split_once(' ').unwrap_or((line, ""));
+        match op {
+            "floppy" => {
+                let (d, f) = arg.split_once(' ').context("floppy <drive> <file>")?;
+                r.cmd.send(EmulatorCommand::InsertFloppy(d.parse()?, f.to_string(), false))?;
+            }
+            "run" => {
+                if !started {
+                    started = true;
+                    r.cmd.send(EmulatorCommand::Run)?;
+                    r.cmd.send(EmulatorCommand::SetSpeed(EmulatorSpeed::Uncapped))?;
+                }
+                r.run(arg.parse()?)?;
+            }
+            "until" => {
+                let (s, f) = arg.split_once(' ').context("until <secs> <file>")?;
+                r.until_idle(s.parse()?)?;
+                r.shot(f)?;
+            }
+            "shot" => r.shot(arg)?,
+            "move" => {
+                let (x, y) = arg.split_once(' ').context("move <x> <y>")?;
+                r.send(EmulatorCommand::MouseUpdateAbsolute { x: x.parse()?, y: y.parse()? })?;
+            }
+            "down" => r.button(true)?,
+            "up" => r.button(false)?,
+            "click" => {
+                r.button(true)?;
+                r.button(false)?;
+            }
+            "dclick" => {
+                r.button(true)?;
+                r.button(false)?;
+                r.button(true)?;
+                r.button(false)?;
+            }
+            "key" => {
+                let mut it = arg.split_whitespace();
+                let sc = u8::from_str_radix(it.next().context("key <hex>")?, 16)?;
+                r.key(sc, it.next() == Some("cmd"))?;
+            }
+            "type" => {
+                for c in arg.chars() {
+                    let (sc, shift) = scancode(c).with_context(|| format!("cannot type {:?}", c))?;
+                    if shift {
+                        r.send(EmulatorCommand::KeyEvent(KeyEvent::KeyDown(0x38, Keymap::AekM0115)))?;
+                    }
+                    r.key(sc, false)?;
+                    if shift {
+                        r.send(EmulatorCommand::KeyEvent(KeyEvent::KeyUp(0x38, Keymap::AekM0115)))?;
+                    }
+                }
+            }
+            _ => bail!("unknown command: {}", line),
+        }
+    }
+    Ok(())
+}
