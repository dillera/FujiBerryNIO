+
+TEST_CASE("MacFloppyFramer: a DiskCopy 4.2 floppy is served from its sectors")
+{
+    Rig rig;
+    // An 800K DiskCopy 4.2 image with tags: header, data, then 12-byte tags.
+    const auto data = patterned(1600);
+    std::vector<std::uint8_t> dc42(0x54, 0);
+    const char name[] = "Test Disk";
+    dc42[0] = std::uint8_t(sizeof(name) - 1);
+    std::memcpy(dc42.data() + 1, name, sizeof(name) - 1);
+    auto put32 = [&](std::size_t at, std::uint32_t v) {
+        dc42[at] = std::uint8_t(v >> 24);
+        dc42[at + 1] = std::uint8_t(v >> 16);
+        dc42[at + 2] = std::uint8_t(v >> 8);
+        dc42[at + 3] = std::uint8_t(v);
+    };
+    put32(0x40, std::uint32_t(data.size()));
+    put32(0x44, 1600 * 12);
+    dc42[0x50] = 1;    // 800K
+    dc42[0x51] = 0x22; // format byte
+    dc42[0x52] = 0x01; // magic 0x0100
+    dc42[0x53] = 0x00;
+    dc42.insert(dc42.end(), data.begin(), data.end());
+    dc42.insert(dc42.end(), 1600 * 12, 0xEE);
+    rig.fs->file_bytes("/fl.image") = dc42;
+
+    REQUIRE(rig.disks->mount(MacFloppyFramer::FLOPPY_SLOT, "mem", "/fl.image", {}).ok());
+    CHECK(rig.disks->info(MacFloppyFramer::FLOPPY_SLOT).geometry.sectorCount == 1600);
+    CHECK(rig.exchange({}) == std::vector<std::uint8_t>{'d', 0x80, 'u'});
+
+    // Cylinder 1, side 1: its sectors come from the data, past the header.
+    auto reply = rig.exchange({'#', 1, 1});
+    REQUIRE(reply.size() > 7);
+    REQUIRE(reply[0] == '#');
+    CHECK(reply[1] == 1);
+    CHECK(reply[2] == 1);
+    const std::uint32_t nbits = (std::uint32_t(reply[3]) << 24) | (std::uint32_t(reply[4]) << 16) |
+                                (std::uint32_t(reply[5]) << 8) | reply[6];
+    std::vector<std::uint8_t> track(reply.begin() + 7, reply.end());
+    std::vector<mac_gcr_written_sector> found(24);
+    const int n = mac_gcr_decode_capture(track.data(), nbits, found.data(), int(found.size()));
+    REQUIRE(n == mac_gcr_sectors_per_track(1));
+    const int nsec = mac_gcr_sectors_per_track(1);
+    for (int i = 0; i < n; ++i) {
+        const auto& w = found[std::size_t(i)];
+        const std::size_t lba = std::size_t(mac_gcr_sectors_before_cyl(1) * 2 + nsec + w.sector);
+        CHECK(std::memcmp(w.data + MAC_GCR_TAG_SIZE, data.data() + lba * 512, 512) == 0);
+    }
+
+    // A written sector lands in the data area, not over the header or tags.
+    std::uint8_t sector[MAC_GCR_SECTOR_TOTAL];
+    std::memset(sector, 0, MAC_GCR_TAG_SIZE);
+    std::memset(sector + MAC_GCR_TAG_SIZE, 0x5C, MAC_GCR_SECTOR_SIZE);
+    REQUIRE(mac_gcr_patch_sector(track.data(), track.size(), 1, MAC_GCR_FORMAT_DS, 2, sector));
+    std::vector<std::uint8_t> cmd{'P', 1, 1, std::uint8_t(nbits >> 24), std::uint8_t(nbits >> 16),
+                                  std::uint8_t(nbits >> 8), std::uint8_t(nbits)};
+    cmd.insert(cmd.end(), track.begin(), track.end());
+    CHECK(rig.exchange(cmd) == std::vector<std::uint8_t>{'p', 1});
+    const auto& file = rig.fs->file_bytes("/fl.image");
+    const std::size_t lba = std::size_t(mac_gcr_sectors_before_cyl(1) * 2 + nsec + 2);
+    CHECK(file[0x54 + lba * 512] == 0x5C);
+    CHECK(file[0x54 + lba * 512 + 511] == 0x5C);
+    CHECK(file[0] == sizeof(name) - 1);
+    CHECK(file[0x54 + 1600 * 512] == 0xEE);
+}
