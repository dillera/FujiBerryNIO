+
+MacFloppyFramer::MacFloppyFramer(disk::DiskService& disks,
+                                 std::function<void(std::size_t)> onEject,
+                                 bool serveFloppy)
+    : _disks(disks)
+    , _onEject(std::move(onEject))
+    , _serveFloppy(serveFloppy)
+{
+}
+
+void MacFloppyFramer::poll(Channel& ch)
+{
+    std::uint8_t buf[1024];
+    while (ch.available()) {
+        const std::size_t n = ch.read(buf, sizeof(buf));
+        if (n == 0) {
+            break;
+        }
+        _rx.insert(_rx.end(), buf, buf + n);
+    }
+
+    while (!_rx.empty() && handle_command(ch)) {
+    }
+
+    if (!_polled) {
+        announce_units(ch, false);
+        announce_floppy(ch);
+    }
+}
+
+bool MacFloppyFramer::nextPacket(ByteBuffer& outPacket)
+{
+    if (_packets.empty()) {
+        return false;
+    }
+    outPacket = std::move(_packets.front());
+    _packets.pop_front();
+    return true;
+}
+
+void MacFloppyFramer::sendPacket(Channel&, const ByteBuffer& packet)
+{
+    // Held until the Mac reads the mailbox; nothing goes on the wire here.
+    if (packet.size() > MAILBOX_MAX_PACKET) {
+        FN_LOGW(TAG, "response of %zu bytes exceeds the mailbox; dropped", packet.size());
+        _response.clear();
+    } else {
+        _response.assign(packet.begin(), packet.end());
+    }
+    _responseSeq = _requestSeq;
+    _state = Ready;
+}
+
+bool MacFloppyFramer::handle_command(Channel& ch)
+{
+    const std::uint8_t c = _rx.front();
+
+    if (c >= 'A' && c <= 'E') {
+        _rx.pop_front();
+        _unit = std::size_t(c - 'A');
+        return true;
+    }
+
+    switch (c) {
+    case '!':
+        _rx.pop_front();
+        _polled = true;
+        return true;
+
+    case '?':
+        _rx.pop_front();
+        if (_polled) {
+            const int sides = floppy_sides();
+            const bool ro = sides && _disks.info(FLOPPY_SLOT).readOnly;
+            const std::uint8_t reply[3] = {'h', std::uint8_t(count_units()),
+                                           std::uint8_t(sides | (ro ? 0x80 : 0))};
+            ch.write(reply, sizeof(reply));
+            return true;
+        }
+        // A drive side (re)connecting: tell it everything afresh.
+        _floppyAnnounced = 0;
+        announce_units(ch, true);
+        return true;
+
+    case '0': case '1': case '2': case '4': case '6': case '7':
+        _rx.pop_front();
+        return floppy_command(ch, c);
+
+    case '#': {
+        if (_rx.size() < 3) {
+            return false;
+        }
+        const int cyl = _rx[1];
+        const int side = _rx[2];
+        _rx.erase(_rx.begin(), _rx.begin() + 3);
+        const std::vector<std::uint8_t> track = encode_track(cyl, side);
+        std::uint8_t len[4];
+        put_be32(len, std::uint32_t(track.size() * 8));
+        ch.write(len, sizeof(len));
+        if (!track.empty()) {
+            ch.write(track.data(), track.size());
+        }
+        return true;
+    }
+
+    case 'P': {
+        if (_rx.size() < 7) {
+            return false;
+        }
+        const std::uint32_t nbits = (std::uint32_t(_rx[3]) << 24) | (std::uint32_t(_rx[4]) << 16) |
+                                    (std::uint32_t(_rx[5]) << 8) | _rx[6];
+        const std::size_t nbytes = (nbits + 7) / 8;
+        if (_rx.size() < 7 + nbytes) {
+            return false;
+        }
+        const int cyl = _rx[1];
+        const int side = _rx[2];
+        std::vector<std::uint8_t> bits(_rx.begin() + 7, _rx.begin() + 7 + nbytes);
+        _rx.erase(_rx.begin(), _rx.begin() + 7 + nbytes);
+        const int n = write_track(cyl, side, bits.data(), nbits);
+        const std::uint8_t reply[2] = {'p', std::uint8_t(n < 0 ? 0 : n)};
+        ch.write(reply, sizeof(reply));
+        return true;
+    }
+
+    case 'T': {
+        _rx.pop_front();
+        std::uint8_t status[STATUS_BYTES];
+        build_status(_unit, status);
+        ch.write(status, sizeof(status));
+        return true;
+    }
+
+    case 'R': {
+        if (_rx.size() < 4) {
+            return false;
+        }
+        std::uint8_t hdr[4];
+        std::copy_n(_rx.begin(), 4, hdr);
+        _rx.erase(_rx.begin(), _rx.begin() + 4);
+        std::uint8_t block[BLOCK_BYTES];
+        read_block(_unit, be24(hdr + 1), block);
+        ch.write(block, sizeof(block));
+        return true;
+    }
+
+    case 'W': {
+        if (_rx.size() < 4 + BLOCK_BYTES) {
+            return false;
+        }
+        std::uint8_t hdr[4];
+        std::copy_n(_rx.begin(), 4, hdr);
+        std::uint8_t block[BLOCK_BYTES];
+        std::copy_n(_rx.begin() + 4, BLOCK_BYTES, block);
+        _rx.erase(_rx.begin(), _rx.begin() + 4 + BLOCK_BYTES);
+        const std::uint8_t ack = write_block(_unit, be24(hdr + 1), block) ? 'w' : 'e';
+        ch.write(&ack, 1);
+        return true;
+    }
+
+    default:
+        // Anything else (the board's write-capture frames among them, which
+        // need its WR capture wiring): consume the byte to stay in step.
+        FN_LOGD(TAG, "ignoring drive-side byte 0x%02X", c);
+        _rx.pop_front();
+        return true;
+    }
+}
+
+std::uint32_t MacFloppyFramer::image_blocks(std::size_t unit)
+{
+    const disk::DiskSlotInfo info = _disks.info(unit);
+    if (!info.inserted) {
+        return 0;
+    }
+    const std::uint64_t bytes =
+        std::uint64_t(info.geometry.sectorSize) * info.geometry.sectorCount;
+    return std::uint32_t(bytes / BLOCK_BYTES);
+}
+
+std::size_t MacFloppyFramer::count_units()
+{
+    if (!_pendingActivated) {
+        // Config-defined (lazy) mounts, such as the boot disk, only open on
+        // first access. The Mac probes its drives once, at boot, so open
+        // them before the drive side asks how many there are.
+        _pendingActivated = true;
+        for (std::size_t u = 0; u <= FLOPPY_SLOT; ++u) {
+            if (_disks.get_pending_mount(u)) {
+                const auto r = _disks.ensure_mounted(u);
+                FN_LOGI(TAG, "unit %zu: pending mount %s", u, r.ok() ? "opened" : "failed");
+            }
+        }
+    }
+
+    std::size_t n = 0;
+    while (n < DCD_UNITS && image_blocks(n) > 0) {
+        ++n;
+    }
+    return n;
+}
+
+void MacFloppyFramer::announce_units(Channel& ch, bool force)
+{
+    const int n = int(count_units());
+    if (!force && n == _announced) {
+        return;
+    }
+    if (n != _announced) {
+        FN_LOGI(TAG, "%d DCD unit(s) in the chain", n);
+    }
+    _announced = n;
+    const std::uint8_t msg[2] = {'h', std::uint8_t(n)};
+    ch.write(msg, sizeof(msg));
+}
+
+int MacFloppyFramer::floppy_sides()
+{
+    if (!_serveFloppy) {
+        return 0;
+    }
+    const disk::DiskSlotInfo info = _disks.info(FLOPPY_SLOT);
+    if (!info.inserted) {
+        return 0;
+    }
+    const std::uint64_t bytes = std::uint64_t(info.geometry.sectorSize) * info.geometry.sectorCount;
+    if (bytes == MAC_GCR_400K_BYTES) {
+        return 1;
+    }
+    if (bytes == MAC_GCR_800K_BYTES) {
+        return 2;
+    }
+    return 0;
+}
+
+void MacFloppyFramer::announce_floppy(Channel& ch)
+{
+    const int sides = floppy_sides();
+    if (sides == _floppyAnnounced) {
+        return;
+    }
+    if (sides == 0) {
+        FN_LOGI(TAG, "floppy removed");
+        const std::uint8_t msg = 'r';
+        ch.write(&msg, 1);
+    } else {
+        const bool ro = _disks.info(FLOPPY_SLOT).readOnly;
+        FN_LOGI(TAG, "floppy inserted: %s, %s", sides == 2 ? "800K" : "400K",
+                ro ? "write protected" : "writable");
+        _head = 0;
+        const std::uint8_t msg[3] = {std::uint8_t(sides == 2 ? 'd' : 's'),
+                                     std::uint8_t(0x80 | _head), std::uint8_t(ro ? 'l' : 'u')};
+        ch.write(msg, sizeof(msg));
+    }
+    _floppyAnnounced = sides;
+}
+
+bool MacFloppyFramer::floppy_command(Channel& ch, std::uint8_t c)
+{
+    std::uint8_t reply = 0;
+
+    switch (c) {
+    case '0':
+        _stepDir = 1;
+        return true;
+    case '4':
+        _stepDir = -1;
+        return true;
+    case '1':
+        if (floppy_sides() == 0) {
+            reply = 'N';
+        } else {
+            _head = std::clamp(_head + _stepDir, 0, MAC_GCR_CYLINDERS - 1);
+            reply = std::uint8_t(0x80 | _head);
+        }
+        break;
+    case '2':
+        reply = 'M';
+        break;
+    case '6':
+        if (floppy_sides() != 0) {
+            _disks.flush(FLOPPY_SLOT);
+        }
+        reply = 'F';
+        break;
+    case '7':
+        // The Mac ejected the disk: clear the slot, as the FujiNet Mac
+        // firmware does. The drive side already knows, so no 'r'.
+        FN_LOGI(TAG, "floppy ejected by the Mac");
+        if (floppy_sides() != 0) {
+            if (_onEject) {
+                _onEject(FLOPPY_SLOT);
+            } else {
+                _disks.flush(FLOPPY_SLOT);
+                _disks.unmount(FLOPPY_SLOT);
+            }
+        }
+        _floppyAnnounced = 0;
+        reply = 'E';
+        break;
+    default:
+        return true;
+    }
+    ch.write(&reply, 1);
+    return true;
+}
+
+std::vector<std::uint8_t> MacFloppyFramer::encode_track(int cyl, int side)
+{
+    const int sides = floppy_sides();
+    if (sides == 0 || cyl < 0 || cyl >= MAC_GCR_CYLINDERS || side < 0 || side >= sides) {
+        return {};
+    }
+    const int nsec = mac_gcr_sectors_per_track(cyl);
+    const std::uint32_t first = std::uint32_t(mac_gcr_sectors_before_cyl(cyl) * sides + side * nsec);
+
+    // Sector images hold cylinders in order, both sides of a cylinder together.
+    std::vector<std::uint8_t> sectors(std::size_t(nsec) * MAC_GCR_SECTOR_SIZE);
+    for (int i = 0; i < nsec; ++i) {
+        read_block(FLOPPY_SLOT, first + std::uint32_t(i), sectors.data() + i * MAC_GCR_SECTOR_SIZE);
+    }
+
+    std::vector<std::uint8_t> track(mac_gcr_track_bytes(cyl));
+    const std::uint32_t nbits = mac_gcr_encode_track(
+        sectors.data(), nullptr, cyl, side,
+        sides == 2 ? MAC_GCR_FORMAT_DS : MAC_GCR_FORMAT_SS, track.data(), track.size());
+    track.resize(nbits / 8);
+    return track;
+}
+
+int MacFloppyFramer::write_track(int cyl, int side, const std::uint8_t* bits, std::uint32_t nbits)
+{
+    const int sides = floppy_sides();
+    if (sides == 0 || cyl < 0 || cyl >= MAC_GCR_CYLINDERS || side < 0 || side >= sides) {
+        return 0;
+    }
+    if (_disks.info(FLOPPY_SLOT).readOnly) {
+        FN_LOGW(TAG, "floppy is write protected; track %d.%d not written", cyl, side);
+        return 0;
+    }
+
+    // Decode the track twice over so a field written across the index
+    // (the end of the bitstream) is found too.
+    std::vector<std::uint8_t> twice(bits, bits + (nbits + 7) / 8);
+    std::uint32_t total = nbits;
+    if (nbits % 8 == 0) {
+        twice.insert(twice.end(), bits, bits + nbits / 8);
+        total = nbits * 2;
+    }
+    std::vector<mac_gcr_written_sector> found(MAC_GCR_MAX_SECTORS * 3);
+    const int n = mac_gcr_decode_capture(twice.data(), total, found.data(), int(found.size()));
+
+    const int nsec = mac_gcr_sectors_per_track(cyl);
+    std::uint32_t done = 0; // bit per sector
+    int written = 0;
+    for (int i = 0; i < n; ++i) {
+        const mac_gcr_written_sector& w = found[std::size_t(i)];
+        const int c = w.cyl >= 0 ? w.cyl : cyl;
+        const int sd = w.side >= 0 ? w.side : side;
+        if (!w.checksum_ok || c != cyl || sd != side || w.sector >= nsec || (done & (1u << w.sector))) {
+            continue;
+        }
+        done |= 1u << w.sector;
+
+        const std::uint32_t lba =
+            std::uint32_t(mac_gcr_sectors_before_cyl(cyl) * sides + side * nsec + w.sector);
+        std::uint8_t current[BLOCK_BYTES];
+        read_block(FLOPPY_SLOT, lba, current);
+        const std::uint8_t* data = w.data + MAC_GCR_TAG_SIZE;
+        if (std::memcmp(current, data, BLOCK_BYTES) == 0) {
+            continue;
+        }
+        if (write_block(FLOPPY_SLOT, lba, data)) {
+            ++written;
+        }
+    }
+    if (written > 0) {
+        _disks.flush(FLOPPY_SLOT);
+        FN_LOGI(TAG, "floppy track %d.%d: %d sector(s) written", cyl, side, written);
+    }
+    return written;
+}
+
+void MacFloppyFramer::read_block(std::size_t unit, std::uint32_t block, std::uint8_t* out)
+{
+    std::memset(out, 0, BLOCK_BYTES);
+    const std::uint32_t blocks = image_blocks(unit);
+
+    if (block >= blocks) {
+        if (blocks > 0 && block - blocks < MAILBOX_BLOCKS) {
+            mailbox_read(block - blocks, out);
+        } else {
+            FN_LOGW(TAG, "unit %zu: read of block %u beyond the disk", unit, (unsigned)block);
+        }
+        return;
+    }
+
+    const disk::DiskSlotInfo info = _disks.info(unit);
+    const std::uint16_t ss = info.geometry.sectorSize;
+    if (ss == 0 || BLOCK_BYTES % ss != 0) {
+        FN_LOGW(TAG, "unit %zu: sector size %u cannot serve 512-byte blocks", unit, (unsigned)ss);
+        return;
+    }
+    const std::uint32_t per = std::uint32_t(BLOCK_BYTES / ss);
+    const auto r = _disks.read_sectors(unit, block * per, std::uint16_t(per), out, BLOCK_BYTES);
+    if (!r.ok()) {
+        FN_LOGW(TAG, "unit %zu: read of block %u failed (%u)", unit, (unsigned)block, (unsigned)r.error);
+    }
+}
+
+bool MacFloppyFramer::write_block(std::size_t unit, std::uint32_t block, const std::uint8_t* in)
+{
+    const std::uint32_t blocks = image_blocks(unit);
+
+    if (block >= blocks) {
+        if (blocks > 0 && block - blocks < MAILBOX_BLOCKS) {
+            mailbox_write(block - blocks, in);
+            return true;
+        }
+        FN_LOGW(TAG, "unit %zu: write of block %u beyond the disk", unit, (unsigned)block);
+        return false;
+    }
+
+    const disk::DiskSlotInfo info = _disks.info(unit);
+    const std::uint16_t ss = info.geometry.sectorSize;
+    if (ss == 0 || BLOCK_BYTES % ss != 0) {
+        return false;
+    }
+    const std::uint32_t per = std::uint32_t(BLOCK_BYTES / ss);
+    const auto r = _disks.write_sectors(unit, block * per, std::uint16_t(per), in, BLOCK_BYTES);
+    if (!r.ok()) {
+        FN_LOGW(TAG, "unit %zu: write of block %u failed (%u)", unit, (unsigned)block, (unsigned)r.error);
+        return false;
+    }
+    return true;
+}
+
+void MacFloppyFramer::build_status(std::size_t unit, std::uint8_t* out)
+{
+    // The HD20 status block from byte 6 of the response payload on, laid
+    // out as the FujiNet Mac firmware sends it; the drive side adds the
+    // 0x83 header and the checksum.
+    std::uint8_t p[6 + STATUS_BYTES] = {}; // indexed with the payload offsets of the spec
+
+    const std::uint32_t blocks = image_blocks(unit);
+    const disk::DiskSlotInfo info = _disks.info(unit);
+    const std::uint32_t reported = blocks ? blocks + MAILBOX_BLOCKS : 0;
+
+    p[7] = 1;  // device type
+    p[9] = 1;  // manufacturer
+    p[10] = 0x80 | 0x40 | 0x20 | 0x04 | 0x02; // mountable, readable, writable, icon, disk in place
+    if (info.readOnly) {
+        p[10] |= 0x08;
+    }
+    p[11] = std::uint8_t(reported >> 16);
+    p[12] = std::uint8_t(reported >> 8);
+    p[13] = std::uint8_t(reported);
+
+    std::memcpy(&p[70], kIcon, sizeof(kIcon));
+    for (int i = 0; i < 6; ++i) {
+        p[70 + 96 + 4 * i] = std::uint8_t(~kDigits[unit & 3][i]);
+    }
+    std::memset(&p[198], 0xFF, 128);
+    p[326] = 10;
+    std::memcpy(&p[327], "FujiNet_D", 9);
+    p[336] = std::uint8_t('1' + unit);
+    std::memcpy(out, p + 6, STATUS_BYTES);
+}
+
+void MacFloppyFramer::mailbox_read(std::uint32_t index, std::uint8_t* out)
+{
+    const std::size_t start = index * BLOCK_BYTES;
+
+    if (index == 0) {
+        std::memcpy(out, "FNIO", 4);
+        out[4] = MAILBOX_VERSION;
+        out[5] = _state;
+        put_be16(out + 6, _state == Ready ? _responseSeq : _requestSeq);
+        put_be32(out + 8, _state == Ready ? std::uint32_t(_response.size()) : 0);
+    }
+
+    // Packet byte k lives at mailbox offset MAILBOX_HEADER + k.
+    for (std::size_t off = (index == 0 ? MAILBOX_HEADER : 0); off < BLOCK_BYTES; ++off) {
+        const std::size_t k = start + off - MAILBOX_HEADER;
+        if (_state != Ready || k >= _response.size()) {
+            break;
+        }
+        out[off] = _response[k];
+    }
+}
+
+void MacFloppyFramer::mailbox_write(std::uint32_t index, const std::uint8_t* in)
+{
+    if (index == 0) {
+        if (std::memcmp(in, "FNIO", 4) != 0) {
+            FN_LOGW(TAG, "mailbox write without the FNIO header ignored");
+            _request.clear();
+            return;
+        }
+        const std::uint32_t len = (std::uint32_t(in[8]) << 24) | (std::uint32_t(in[9]) << 16) |
+                                  (std::uint32_t(in[10]) << 8) | in[11];
+        if (len == 0 || len > MAILBOX_MAX_PACKET) {
+            FN_LOGW(TAG, "mailbox request length %u rejected", (unsigned)len);
+            _request.clear();
+            return;
+        }
+        _requestSeq = std::uint16_t((in[6] << 8) | in[7]);
+        _request.assign(MAILBOX_HEADER + len, 0);
+        _requestHave = 0;
+        _state = Pending;
+        _response.clear();
+    }
+    if (_request.empty()) {
+        return;
+    }
+
+    const std::size_t start = index * BLOCK_BYTES;
+    if (start >= _request.size()) {
+        return;
+    }
+    const std::size_t n = std::min(BLOCK_BYTES, _request.size() - start);
+    std::memcpy(_request.data() + start, in, n);
+    _requestHave += n;
+
+    if (_requestHave >= _request.size()) {
+        _packets.emplace_back(_request.begin() + MAILBOX_HEADER, _request.end());
+        FN_LOGD(TAG, "mailbox request seq=%u, %zu bytes", (unsigned)_requestSeq,
+                _request.size() - MAILBOX_HEADER);
+        _request.clear();
+    }
+}
+
+} // namespace fujinet::io
