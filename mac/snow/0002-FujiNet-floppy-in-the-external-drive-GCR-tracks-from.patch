+    /// The FujiNet's floppy goes in the external drive, behind the DCD chain.
+    const FUJINET_FLOPPY_DRIVE: usize = 1;
+
+    /// Applies the FujiNet's floppy announcements to the external drive and
+    /// sends back tracks the Mac wrote once its motor stops.
+    fn fujinet_floppy_housekeeping(&mut self) {
+        let mut insert = None;
+        let mut writable = true;
+        while let Some(ev) = self.dcd.floppy_events.pop_front() {
+            match ev {
+                dcd::FloppyEvent::Inserted { sides } => insert = Some(sides),
+                dcd::FloppyEvent::Writable(w) => writable = w,
+                dcd::FloppyEvent::Removed => {
+                    if self.fujinet_floppy.take().is_some()
+                        && self.drives[Self::FUJINET_FLOPPY_DRIVE].has_disk()
+                    {
+                        log::info!("FujiNet: floppy removed");
+                        self.drives[Self::FUJINET_FLOPPY_DRIVE].eject();
+                    }
+                }
+            }
+        }
+
+        if let Some(sides) = insert {
+            self.fujinet_floppy_insert(sides, writable);
+        }
+
+        let drv = &self.drives[Self::FUJINET_FLOPPY_DRIVE];
+        if self.fujinet_floppy.is_some() && drv.has_disk() && !drv.motor_on() && drv.floppy.is_dirty() {
+            self.fujinet_floppy_sync();
+        }
+    }
+
+    fn fujinet_floppy_insert(&mut self, sides: usize, writable: bool) {
+        let drive = Self::FUJINET_FLOPPY_DRIVE;
+        if !self.drives[drive].is_present() {
+            log::warn!("FujiNet: floppy offered but there is no external drive");
+            return;
+        }
+        if self.drives[drive].has_disk() {
+            log::warn!("FujiNet: floppy offered but the external drive is occupied");
+            return;
+        }
+        let Some(tracks) = self.dcd.floppy_tracks(sides) else {
+            return;
+        };
+        let floppy_type = if sides == 2 {
+            snow_floppy::FloppyType::Mac800K
+        } else {
+            snow_floppy::FloppyType::Mac400K
+        };
+        let mut img = FloppyImage::from_bitstreams(floppy_type, "FujiNet", |side, cyl| {
+            tracks.get(cyl).and_then(|t| t[side].clone())
+        });
+        if !writable {
+            img.set_force_wp();
+        }
+        let synced = tracks
+            .into_iter()
+            .map(|t| t.map(|s| s.map(|(data, _)| data)))
+            .collect();
+        match self.drives[drive].disk_insert(img) {
+            Ok(()) => {
+                log::info!(
+                    "FujiNet: {} floppy inserted in the external drive{}",
+                    if sides == 2 { "800K" } else { "400K" },
+                    if writable { "" } else { " (write protected)" }
+                );
+                self.fujinet_floppy = Some(synced);
+            }
+            Err(e) => log::error!("FujiNet: cannot insert floppy: {}", e),
+        }
+    }
+
+    /// Sends every track that differs from the FujiNet's copy back to it.
+    fn fujinet_floppy_sync(&mut self) {
+        let Some(mut synced) = self.fujinet_floppy.take() else {
+            return;
+        };
+        let drive = Self::FUJINET_FLOPPY_DRIVE;
+        let mut sectors = 0usize;
+        for (cyl, sides) in synced.iter_mut().enumerate() {
+            for (side, last) in sides.iter_mut().enumerate() {
+                let Some(prev) = last.as_mut() else {
+                    continue;
+                };
+                let Some((data, bits)) = self.drives[drive].floppy.track_bitstream(side, cyl) else {
+                    continue;
+                };
+                let bytes = &data[..bits.div_ceil(8)];
+                if prev.as_slice() == bytes {
+                    continue;
+                }
+                let current = bytes.to_vec();
+                match self.dcd.floppy_put_track(cyl, side, &current, bits) {
+                    Some(n) => sectors += n as usize,
+                    None => {
+                        self.fujinet_floppy = Some(synced);
+                        return;
+                    }
+                }
+                *prev = current;
+            }
+        }
+        self.drives[drive].floppy.clear_dirty();
+        if sectors > 0 {
+            log::info!("FujiNet: {} floppy sector(s) written back", sectors);
+        }
+        self.fujinet_floppy = Some(synced);
+    }
