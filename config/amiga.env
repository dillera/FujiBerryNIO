# Licensed AmigaOS media paths -- template.
#
# scripts/03-configure-workspace.sh substitutes __TOSEC__, __KICK__ and
# __PROJ__ and writes the result to <workspace>/local/amiga.env, which the
# workspace keeps out of git.  Nothing here is licensed data, only paths.
#
# __TOSEC__ : TOSEC "Commodore Amiga - Operating Systems - Workbench" folder,
#             one sub-directory per ADF, named like the ADF itself.
# __KICK__  : directory holding the Kickstart ROM dumps.

# --- Workbench 3.1 (rev 40.42) --------------------------------------------
# Kickstart 3.1 40.63 is the A600 ECS ROM, matching a 68000.
AMIGA_WB31_KICKSTART="__KICK__/kick40063.A600"
AMIGA_WB31_ADF_INSTALL="__TOSEC__/Workbench v3.1 rev 40.42 (1994)(Commodore)(M10)(Disk 1 of 6)(Install)[!]/Workbench v3.1 rev 40.42 (1994)(Commodore)(M10)(Disk 1 of 6)(Install)[!].adf"
AMIGA_WB31_ADF_WORKBENCH="__TOSEC__/Workbench v3.1 rev 40.42 (1994)(Commodore)(M10)(Disk 2 of 6)(Workbench)[!]/Workbench v3.1 rev 40.42 (1994)(Commodore)(M10)(Disk 2 of 6)(Workbench)[!].adf"
AMIGA_WB31_ADF_EXTRAS="__TOSEC__/Workbench v3.1 rev 40.42 (1994)(Commodore)(M10)(Disk 3 of 6)(Extras)[!]/Workbench v3.1 rev 40.42 (1994)(Commodore)(M10)(Disk 3 of 6)(Extras)[!].adf"
AMIGA_WB31_ADF_STORAGE="__TOSEC__/Workbench v3.1 rev 40.42 (1994)(Commodore)(M10)(Disk 4 of 6)(Storage)[!]/Workbench v3.1 rev 40.42 (1994)(Commodore)(M10)(Disk 4 of 6)(Storage)[!].adf"
AMIGA_WB31_ADF_LOCALE="__TOSEC__/Workbench v3.1 rev 40.42 (1994)(Commodore)(M10)(Disk 5 of 6)(Locale)[!]/Workbench v3.1 rev 40.42 (1994)(Commodore)(M10)(Disk 5 of 6)(Locale)[!].adf"
AMIGA_WB31_ADF_FONTS="__TOSEC__/Workbench v3.1 rev 40.42 (1994)(Commodore)(M10)(Disk 6 of 6)(Fonts)[!]/Workbench v3.1 rev 40.42 (1994)(Commodore)(M10)(Disk 6 of 6)(Fonts)[!].adf"

# --- Workbench 1.3 ----------------------------------------------------------
# Kickstart 1.3 r34.5 as a plain 256K dump: no Amiga Forever rom.key needed.
# AMIGA_WB13_HDF is generated by scripts/04-build-wb13-hdf.sh.
AMIGA_WB13_KICKSTART="__KICK__/kick34005.A500"
AMIGA_WB13_ADF_WORKBENCH="__TOSEC__/Workbench v1.3.3 rev 34.34 (1990)(Commodore)(A500-A2000)(Disk 1 of 2)(Workbench)/Workbench v1.3.3 rev 34.34 (1990)(Commodore)(A500-A2000)(Disk 1 of 2)(Workbench).adf"
AMIGA_WB13_HDF="__PROJ__/assets/amigaOS1.3/wb13-clean.hdf"
