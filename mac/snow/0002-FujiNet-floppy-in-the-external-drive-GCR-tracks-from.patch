+    /// A floppy command byte ('7' eject ...); returns the reply byte.
+    fn floppy_command(&mut self, c: u8) -> std::io::Result<u8> {
+        self.stream.write_all(&[c])?;
+        let mut r = [0u8; 1];
+        self.read_exact(&mut r)?;
+        Ok(r[0])
+    }
+
+    /// One GCR track, encoded by the FujiNet: (bytes, bits).
+    fn track(&mut self, cyl: usize, side: usize) -> std::io::Result<(Vec<u8>, usize)> {
+        self.stream.write_all(&[b'#', cyl as u8, side as u8])?;
+        let mut len = [0u8; 4];
+        self.read_exact(&mut len)?;
+        let bits = u32::from_be_bytes(len) as usize;
+        let mut data = vec![0u8; bits.div_ceil(8)];
+        self.read_exact(&mut data)?;
+        Ok((data, bits))
+    }
+
+    /// Sends a track back; returns how many sectors the FujiNet wrote.
+    fn put_track(&mut self, cyl: usize, side: usize, data: &[u8], bits: usize) -> std::io::Result<u8> {
+        let mut msg = vec![b'P', cyl as u8, side as u8];
+        msg.extend_from_slice(&(bits as u32).to_be_bytes());
+        msg.extend_from_slice(&data[..bits.div_ceil(8)]);
+        self.stream.write_all(&msg)?;
+        let mut r = [0u8; 2];
+        self.read_exact(&mut r)?;
+        Ok(r[1])
+    }
+
