diff --git a/makefiles/compiler-amigagcc.mk b/makefiles/compiler-amigagcc.mk
index 699c862..33c23c3 100644
--- a/makefiles/compiler-amigagcc.mk
+++ b/makefiles/compiler-amigagcc.mk
@@ -2,6 +2,11 @@ CC := m68k-amigaos-gcc
 
 CFLAGS += -Wall -Wextra -O2 -std=c99
 CFLAGS += -mcpu=68000 -msoft-float
+# -mcrt selects the C runtime headers as well as its libraries, so it must
+# match the link step below.  Compiling against newlib headers and linking
+# clib2 leaves newlib-only symbols unresolved, e.g. the <ctype.h> macros
+# pull in `__locale_ctype_ptr` and fboot fails to link.
+CFLAGS += -mcrt=clib2
 CFLAGS += -I$(APP_INCLUDE_DIR)
 CFLAGS += -I$(CONFIG_NIO_INCLUDE_DIR)
 CFLAGS += -I$(PLATFORM_INCLUDE_DIR)
