# fujinet-nio-workspace local overrides for this Mac.
#
# Installed by scripts/03-configure-workspace.sh into
#   <workspace>/local/config.env
# which scripts/env.sh sources after setting its own defaults.  Every value
# below is a documented workspace override, not a fork.

# --- Amiga cross toolchain -------------------------------------------------
# Upstream defaults to /opt/amiga, which needs root on macOS.  scripts/
# 01-install-toolchain.sh installs bebbo's amiga-gcc under $HOME instead.
export AMIGA_TOOLCHAIN_BIN="${HOME}/opt/amiga/bin"

# --- Amiberry --------------------------------------------------------------
# The Homebrew cask installs an .app bundle, so there is no `amiberry` on
# PATH.  Point the runner straight at the bundle executable.
export AMIBERRY_BIN="/Applications/Amiberry.app/Contents/MacOS/Amiberry"

# --- AmigaOS assets --------------------------------------------------------
# amiberry-testing.md assumes licensed AmigaOS 3.2.  This Mac has an AmigaOS
# 3.1 (Workbench 3.1 rev 40.42) disk set instead, expanded by
# scripts/02-build-amigaos-tree.sh into the same asset-root layout.
export AMIBERRY_ASSET_ROOT="${AMIBERRY_ASSET_ROOT:-__PROJ__/assets/amigaOS3.1}"
export AMIBERRY_KICKSTART="${AMIBERRY_ASSET_ROOT}/ROM/kick31.rom"
export AMIBERRY_WORKBENCH_ADF="${AMIBERRY_ASSET_ROOT}/ADF/Workbench3.1.adf"
export AMIBERRY_OS_ROOT="${AMIBERRY_ASSET_ROOT}"
export AMIBERRY_FAST_FILE_SYSTEM="${AMIBERRY_ASSET_ROOT}/L/FastFileSystem"

# Kickstart 3.1 40.63 is the ECS ROM, matching the 68000 the profiles emulate.
export AMIBERRY_CPU_TYPE=68000

# Use the wb3.1 profile added by scripts/03-configure-workspace.sh rather than
# the upstream wb3.2 default.
export AMIGA_WORKBENCH_CONFIG=wb3.1
